<% layout("/layouts/boilerplate") %>
  
  <style>
  #filters {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    gap: 1.5rem;
    width: 100%;
    padding: 0.5rem 0;
  }

  .filter {
    text-align: center;
    min-width: 70px;
    margin: 0;
    opacity: 0.7;
    flex: 0 0 auto;
  }

  .filter:hover {
    opacity: 1;
    cursor: pointer;
  }

  .filter i {
    font-size: 1.3rem;
  }

  .filter p {
    margin-top: 0.4rem;
    margin-bottom: 0;
    font-size: 0.85rem;
    white-space: nowrap;
  }

  .tax-info {
    display: none;
  }

  .tax-toggle {
    border: 1px solid #ccc;
    border-radius: 1rem;
    min-height: 3.25rem;
    padding: 0.75rem 1rem;
    margin-left: auto;
    margin-top: 0;
    display: flex;
    align-items: center;
    white-space: nowrap;
  }

  /* Tablet */
  @media (max-width: 768px) {
    #filters {
      gap: 1rem;
      overflow-x: auto;
      flex-wrap: nowrap;
      padding: 0.5rem 0 1rem;
      scrollbar-width: thin;
    }

    .filter {
      min-width: 75px;
    }

    .tax-toggle {
      flex-shrink: 0;
      margin-left: 0;
    }
  }

  /* Mobile */
  @media (max-width: 576px) {
    #filters {
      gap: 1.2rem;
      overflow-x: auto;
      flex-wrap: nowrap;
      padding-bottom: 1rem;
    }

    .filter {
      min-width: 65px;
    }

    .filter i {
      font-size: 1.15rem;
    }

    .filter p {
      font-size: 0.75rem;
    }

    .tax-toggle {
      min-height: auto;
      padding: 0.6rem 0.75rem;
      margin-top: 0.5rem;
    }

    .tax-toggle label {
      font-size: 0.75rem;
    }
  }

  /* Listing cards */
  .listing-link {
    text-decoration: none;
    color: inherit;
    display: block;
  }

  .listing-card {
    border: none;
    border-radius: 1rem;
    overflow: hidden;
    margin-bottom: 2rem;
  }

  .listing-card img {
    width: 100%;
    height: 20rem;
    object-fit: cover;
    border-radius: 1rem;
  }

  @media (max-width: 768px) {
    .listing-card img {
      height: 18rem !important;
    }
  }

  @media (max-width: 576px) {
    .listing-card img {
      height: 15rem !important;
    }

    .listing-card {
      margin-bottom: 1.5rem;
    }

    .card-body {
      padding: 0.75rem 0.25rem;
    }
  }
</style>
<div id="filters" class="mb-3">
    <div class="filter">
      <div><i class="fa-solid fa-fire"></i></div>
      <p>Trending</p>
    </div>
    <div class="filter">
      <div><i class="fa-solid fa-bed"></i></div>
      <p>Rooms</p>
    </div>
    <div class="filter">
      <div><i class="fa-solid fa-mountain-city"></i></div>
      <p>Iconic Cities</p>
    </div>
    <div class="filter">
      <div><i class="fa-solid fa-mountain"></i></div>
      <p>Mountains</p>
    </div>
    <div class="filter">
      <div><i class="fa-brands fa-fort-awesome"></i></div>
      <p>Castles</p>
    </div>
    <div class="filter">
      <div><i class="fa-solid fa-person-swimming"></i></div>
      <p>Amazing Pools</p>
    </div>
    <div class="filter">
      <div><i class="fa-solid fa-campground"></i></div>
      <p>camping</p>
    </div>
    <div class="filter">
      <div><i class="fa-solid fa-cow"></i></div>
      <p>farms</p>
    </div>
    <div class="filter">
      <div><i class="fa-regular fa-snowflake"></i> </div>
      <p>Arctic</p>
    </div>
    <div class="filter">
      <div><i class="fa-solid fa-igloo"></i> </div>
      <p>Domes</p>
    </div>
    <div class="filter">
      <div><i class="fa-solid fa-ship"></i> </div>
      <p>Boats</p>
    </div>
      <div class="tax-toggle">
        <div class="form-check-reverse form-switch">
          <input class="form-check-input" type="checkbox" role="switch" id="switchCheckDefault">
          <label class="form-check-label" for="switchCheckDefault">Display total after taxes</label>
        </div>
      </div>
  </div>
<div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4 mt-3">
  <% for(let listing of allListing){ %>
  <a href="/listings/<%= listing._id %>" class="listing-link">
    <div class="card listing-card col">
    <img
  src="<%= listing.image.url %>"
  class="card-img-top"
  alt="listing_image"
  >
    <div class="card-body">
      <p class="card-text">
        <b><%= listing.title %> </b><br>
        &#8377; <%= listing.price.toLocaleString("en-IN")%> / night
        <i class="tax-info">&nbsp;&nbsp; +18% GST</i>
      </p>
    </div>
  </div>
  </a>
<% } %>
</div>

<script>
  let taxSwitch = document.getElementById("switchCheckDefault");
  taxSwitch.addEventListener("click", () => {
    let taxInfo = document.getElementsByClassName("tax-info");
    for(let info of taxInfo){
      if(info.style.display != "inline"){
        info.style.display = "inline";
      }
      else{
        info.style.display="none";
      } 
    }
  })
</script>

